{
  "name": "anatomy-atlas",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/write-deployment-manifest.mjs && tsc -b && vite build",
    "deploy:check": "node scripts/check-deployment.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "knowledge:audit": "vite-node scripts/audit-knowledge.ts",
    "landmarks:audit": "vite-node scripts/audit-landmarks.ts",
    "knowledge:import": "vite-node scripts/import-knowledge.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-node": "3.2.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0"
  }
}
